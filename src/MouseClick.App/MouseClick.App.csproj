<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>钰宇鼠标连点器</AssemblyName>
    <RootNamespace>MouseClick.App</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>../../assets/icons/mouse.ico</ApplicationIcon>
    <!-- 2026/11/23 新增：将管理员清单嵌入桌面 EXE，安装与便携发布共用，不影响测试入口。 -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 2026/11/15 修改：版本由 Directory.Build.props 导入 version.props，调用方发布脚本使用同一值。 -->
    <Product>钰宇鼠标连点器</Product>
    <Description>支持屏幕点选和多位置顺序循环的鼠标连点器</Description>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../assets/icons/mouse.ico" LogicalName="MouseClick.AppIcon.ico" />
    <Content Include="../../assets/icons/LICENSE.CC0-1.0.txt" Link="图标许可.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="../../assets/icons/SOURCE.md" Link="图标来源.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <InternalsVisibleTo Include="MouseClick.WindowsTests" />
    <ProjectReference Include="../MouseClick.Core/MouseClick.Core.csproj" />
  </ItemGroup>
</Project>
